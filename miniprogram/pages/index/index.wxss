.page-shell {
  padding: 28rpx 36rpx 72rpx;
}

.topline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 64rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 6px;
  background: #23765a;
  color: white;
  font-size: 24rpx;
  font-weight: 700;
}

.brand-name {
  color: #65736a;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 54rpx 0 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #78857c;
  font-size: 22rpx;
}

.page-title {
  color: #1e2922;
  font-size: 42rpx;
  font-weight: 700;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 8rpx;
  color: #5b6b60;
  font-size: 22rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #29946a;
}

.mode-switch {
  display: flex;
  padding: 6rpx;
  border-radius: 8px;
  background: #e8ede8;
}

.mode-option {
  flex: 1;
  padding: 22rpx 8rpx;
  border-radius: 6px;
  color: #65736a;
  font-size: 25rpx;
  text-align: center;
}

.mode-option.selected {
  background: #fff;
  color: #1f654d;
  font-weight: 700;
  box-shadow: 0 1px 3px rgba(26, 43, 33, 0.08);
}

.form-section {
  margin-top: 42rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #26332b;
  font-size: 25rpx;
  font-weight: 700;
}

.section-index {
  color: #9ba69e;
  font-size: 20rpx;
  font-weight: 500;
}

.file-picker,
.selected-file,
.format-picker,
.result-file {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 0 24rpx;
  border: 1px solid #dce3dc;
  border-radius: 8px;
  background: #fff;
}

.file-picker {
  gap: 20rpx;
}

.picker-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 1px solid #b8c9bd;
  border-radius: 6px;
  color: #23765a;
  font-size: 38rpx;
  font-weight: 300;
}

.picker-copy,
.file-details {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 8rpx;
}

.picker-title,
.file-name {
  overflow: hidden;
  color: #253129;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-subtitle,
.file-size {
  color: #7b887f;
  font-size: 21rpx;
}

.picker-arrow {
  color: #718077;
  font-size: 34rpx;
}

.file-type {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-right: 20rpx;
  border-radius: 6px;
  background: #e8f1eb;
  color: #23765a;
  font-size: 17rpx;
  font-weight: 700;
}

.remove-file {
  width: 52rpx;
  height: 52rpx;
  color: #8b9690;
  font-size: 38rpx;
}

.format-picker {
  justify-content: space-between;
  min-height: 92rpx;
  color: #253129;
  font-size: 25rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 96rpx;
  margin-top: 38rpx;
  padding: 0 28rpx;
  border-radius: 8px;
  background: #23765a;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.primary-button[disabled] {
  background: #a9b8ae;
  color: #f4f6f3;
}

.primary-button text,
.secondary-button text {
  font-size: 36rpx;
  font-weight: 400;
}

.progress-area {
  margin-top: 38rpx;
  padding: 24rpx;
  border: 1px solid #dce3dc;
  border-radius: 8px;
  background: #fff;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #35443a;
  font-size: 22rpx;
}

.cancel-button {
  margin: 22rpx 0 0 auto;
  color: #9b5948;
  font-size: 22rpx;
}

.result-section {
  margin-top: 42rpx;
}

.result-rule {
  height: 1px;
  margin-bottom: 34rpx;
  background: #dce3dc;
}

.success-label {
  color: #26815e;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.result-file {
  min-height: 96rpx;
}

.result-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #e4f1e9;
  color: #23765a;
  font-size: 24rpx;
}

.secondary-button {
  margin-top: 20rpx;
  background: #fff;
  color: #23664f;
  border: 1px solid #a9c4b2;
}

.result-actions {
  display: flex;
  gap: 14rpx;
}

.result-actions .secondary-button {
  flex: 1;
  min-width: 0;
}

.save-button {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border: 1px solid #dce3dc;
  border-radius: 6px;
  color: #4c5d52;
  font-size: 22rpx;
}

.result-actions .save-button {
  flex: 0 0 auto;
  margin-top: 20rpx;
}

.media-preview {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 6px;
  background: #18231d;
}

.audio-preview {
  width: 100%;
  margin-top: 20rpx;
}

.save-after-download {
  width: 100%;
}

.saved-note,
.config-notice {
  display: block;
  margin-top: 14rpx;
  color: #738078;
  font-size: 21rpx;
}

.config-notice {
  margin-top: 42rpx;
  color: #a05c48;
}
